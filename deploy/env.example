# ── MOID plant appliance (deploy/.env) ──────────────────────────────────────
# Copy:  cp env.example .env
# Then:  ./scripts/gen-secrets.sh
# Edit:  NEXT_PUBLIC_SUPABASE_URL to the URL operators type in the browser.

# Public URL of this server on the plant LAN (no trailing slash).
# Examples: http://10.0.0.50   http://moid.plant.local
# Must match how browsers reach the gateway (port 80 by default).
NEXT_PUBLIC_SUPABASE_URL=http://REPLACE_WITH_PLANT_LAN_IP_OR_HOSTNAME

# Filled by ./scripts/gen-secrets.sh — do not use demo keys on a plant box.
JWT_SECRET=
POSTGRES_PASSWORD=
DB_AUTHENTICATOR_PASSWORD=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Host port for the LAN gateway (HTTP).
MOID_HTTP_PORT=80

# Image tag written by build (local | 1.0.0 | …).
MOID_IMAGE_TAG=local

# Multi-plant on one install (rare). Default is fine for one site.
MOID_COMPANY_ID=default

# Leave empty on plant (never use memory store in production).
# MOID_STORE=memory

# ── Sign-in (always on; filled in by ./scripts/gen-secrets.sh) ───────────────
# Logins = topbar roles (gm / owner / operator). There are NO default
# passwords: a role with no password set cannot sign in, and the app will not
# start without MOID_AUTH_SECRET.
MOID_AUTH_SECRET=
MOID_AUTH_PASSWORD_GM=
MOID_AUTH_PASSWORD_OWNER=
MOID_AUTH_PASSWORD_OPERATOR=


# ── Optional local LLM (air-gapped) ─────────────────────────────────────────
# OpenAI-compatible base URL reachable from the app container.
# Examples:
#   http://172.17.0.1:8000/v1          (LLM on Docker host)
#   http://llm:11434/v1                (if you add an Ollama service on the compose network)
# Leave blank: app runs; chat / assisted mapping report "no AI backend".
MINICPM_BASE_URL=
MINICPM_API_KEY=local
MINICPM_MODEL=
MINICPM_MODEL_FAST=
RAIS_AI_BACKEND=minicpm

# ── Backup ──────────────────────────────────────────────────────────────────
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
